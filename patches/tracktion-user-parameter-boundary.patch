+void ParameterChangeHandler::setUserChangeListener (UserChangeListener* l)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    userChangeListener.store (l, std::memory_order_release);
+}
+
+bool ParameterChangeHandler::requestParameterChange (AutomatableParameter& p, float value, juce::NotificationType nt)
+{
+    if (auto* l = userChangeListener.load (std::memory_order_acquire))
+    {
+        // Reject off-thread writes before touching the Edit; no lock, allocation or IO.
+        auto* mm = juce::MessageManager::getInstanceWithoutCreating();
+        if (mm == nullptr || ! mm->isThisTheMessageThread())
+            return false;
+        return l->requestParameterChange (p, value, nt);
+    }
+    return true;
+}
+
+bool ParameterChangeHandler::requestParameterGesture (AutomatableParameter& p, bool beginning)
+{
+    if (auto* l = userChangeListener.load (std::memory_order_acquire))
+    {
+        auto* mm = juce::MessageManager::getInstanceWithoutCreating();
+        if (mm == nullptr || ! mm->isThisTheMessageThread())
+            return false;
+        return l->requestParameterGesture (p, beginning);
+    }
+    return true;
+}
