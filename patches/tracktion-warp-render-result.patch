+bool AudioClipBase::bindPreparedSourceRender (const AudioFile& source)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    if (edit.shouldPlay() || ! getWarpTime()
+         || source.engine != &edit.engine || ! source.isValid() || source.getInfo().bitsPerSample != 32)
+        return false;
+    setCurrentSourceFile (source.getFile());
+    return true;
+}
+
+bool AudioClipBase::pinPreparedSourceDestination (const AudioFile& destination)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    if (edit.shouldPlay() || destination.engine != &edit.engine || destination.getFile() == getOriginalFile()
+         || (! getWarpTime() && ! bool (state.getChildWithName ("NDAW_ELASTIC_PROXY")["window"])))
+        return false;
+    stopTimer();
+    if (getWarpTime())
+        setCurrentSourceFile (destination.getFile());
+    else
+        preparedElasticProxy = destination;
+    return true;
+}
+
+std::shared_ptr<AudioClipBase::PreparedSourceTask> AudioClipBase::prepareAuditionSource (const AudioFile& destination)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    if (edit.shouldPlay() || destination.engine != &edit.engine || destination.getFile() == getOriginalFile()
+         || (! getWarpTime() && ! bool (state.getChildWithName ("NDAW_ELASTIC_PROXY")["window"])))
+        return {};
+    stopTimer(); // The coordinator, not the clip's proxy timer, owns this preparation.
+    auto task = std::make_shared<PreparedSourceTask>();
+    auto* job = new ProxyGeneratorJob (AudioFile (edit.engine, getOriginalFile()), destination, *this, true, task);
+    // Runtime-only reference pins the destination before it exists. This Edit cannot
+    // play, and L1 will not install the audition graph until the real file is verified.
+    if (getWarpTime())
+        setCurrentSourceFile (destination.getFile());
+    else
+        preparedElasticProxy = destination;
+    edit.engine.getAudioFileManager().proxyGenerator.beginJob (job);
+    return task;
+}
+
+bool AudioClipBase::bindPreparedElasticProxy (const AudioFile& file)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    if (edit.shouldPlay() || ! bool (state.getChildWithName ("NDAW_ELASTIC_PROXY")["window"])
+         || file.engine != &edit.engine || ! file.isValid())
+        return false;
+    preparedElasticProxy = file;
+    stopTimer();
+    return true;
+}
 
