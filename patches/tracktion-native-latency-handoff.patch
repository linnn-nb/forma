+bool ExternalPlugin::refreshLatencyFromInstance()
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    if (! isInstancePrepared.load (std::memory_order_acquire))
+        return false;
+
+    if (auto* pi = getAudioPluginInstance())
+        if (const auto samples = pi->getLatencySamples(); samples >= 0 && samples != latencySamples)
+        {
+            latencySamples = samples;
+            latencySeconds = samples / sampleRate;
+            return true;
+        }
+
+    return false;
+}
+
 void ExternalPlugin::applyToBuffer (const PluginRenderContext& fc)
 {
+    // Covers manually clocked hosted renders on the message thread too. This
+    // is a re-entry guard, not a lock for synchronising plugin internals.
+    static_assert (std::atomic<uint32_t>::is_always_lock_free);
+    struct ProcessingActivity
+    {
+        std::atomic<uint32_t>& depth;
+        explicit ProcessingActivity (std::atomic<uint32_t>& value) noexcept : depth (value)
+        {
+            depth.fetch_add (1, std::memory_order_acq_rel);
+        }
+        ~ProcessingActivity() noexcept { depth.fetch_sub (1, std::memory_order_release); }
+    } activity (processingDepth);
+
     if (! hasLoadedInstance.load (std::memory_order_acquire))
         return;
 
