+std::unique_ptr<tracktion::graph::Node> createNodeForAuditionClips (const juce::Array<Clip*>& clips,
+                                                                   const CreateNodeParams& params)
+{
+    std::vector<std::unique_ptr<Node>> nodes;
+    for (auto* clip : clips)
+        if (clip != nullptr && ! clip->disabled)
+            if (auto* audio = dynamic_cast<AudioClipBase*> (clip))
+                if (auto node = createNodeForAudioClip (*audio, false, params, ClipRole::arranger))
+                    nodes.push_back (std::move (node));
+    if (nodes.empty())
+        return {};
+    if (nodes.size() == 1)
+        return std::move (nodes.front());
+    return std::make_unique<SummingNode> (std::move (nodes));
+}
