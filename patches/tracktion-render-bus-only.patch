+// A printed receiver replaces its main inputs, but those inputs may still feed
+// other live sends or sidechains. Keep that branch as a sink, never add it to
+// the receiver cache a second time. Graph preparation only, no callback work.
+bool hasLivePrintedInputBranch (Track& track)
+{
+    if (auto audio = dynamic_cast<AudioTrack*> (&track))
+    {
+        if (isSidechainSource (*audio))
+            return true;
+        for (auto plugin : audio->pluginList)
+            if (dynamic_cast<AuxSendPlugin*> (plugin) != nullptr && plugin->isEnabled()
+                && ! plugin->isFrozen() && ! (bool) plugin->state.getProperty ("ndaw_print_baked", false))
+                return true;
+        for (auto input : getDirectInputTracks (*audio))
+            if (hasLivePrintedInputBranch (*input))
+                return true;
+    }
+    if (auto folder = dynamic_cast<FolderTrack*> (&track))
+        for (auto child : folder->getAllSubTracks (false))
+            if (hasLivePrintedInputBranch (*child))
+                return true;
+    return false;
+}
