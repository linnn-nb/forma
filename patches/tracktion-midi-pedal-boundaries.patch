 namespace tracktion::inline engine {
 
+// Playback-only state, shared across a prepared graph replacement just like
+// ActiveNoteList. Never read its mutable masks from the preparing thread.
+struct MidiPedalState
+{
+    uint32_t sustainChannels = 0, sostenutoChannels = 0;
+
+    void observe (const juce::MidiMessage& m) noexcept
+    {
+        if (! m.isController())
+            return;
+        const auto bit = uint32_t (1) << m.getChannel();
+        const auto controller = m.getControllerNumber();
+        if (controller == 121) // Reset All Controllers releases both pedals.
+        {
+            sustainChannels &= ~bit;
+            sostenutoChannels &= ~bit;
+        }
+        else if (controller == 64 || controller == 66)
+        {
+            auto& channels = controller == 64 ? sustainChannels : sostenutoChannels;
+            if (m.getControllerValue() >= 64)
+                channels |= bit;
+            else
+                channels &= ~bit;
+        }
+    }
+
+    uint32_t heldChannels() const noexcept { return sustainChannels | sostenutoChannels; }
+    void reset() noexcept { sustainChannels = sostenutoChannels = 0; }
+};
+
+// Prepared MIDI-1 pedal chase. Only construction allocates. A seek retriggers
+// voices; it cannot reconstruct an instrument's private oscillator/envelope state.
+class MidiPedalChase
+{
+public:
+    explicit MidiPedalChase (const juce::MidiMessageSequence& sequence)
+    {
+        bool hasPedalEvent = false;
+        for (const auto* event : sequence)
+            if (event->message.isController() &&
+                (event->message.getControllerNumber() == 64 || event->message.getControllerNumber() == 66))
+                hasPedalEvent = true;
+        if (! hasPedalEvent)
+            return;
+        std::array<int, 2048> keys;
+        keys.fill (-1);
+        std::array<std::vector<int>, 16> alive;
+        std::array<bool, 16> sustain {}, sostenuto {};
+        std::array<int, 16> rise;
+        rise.fill (-1);
+        auto close = [&] (int ch, double time)
+        {
+            auto& a = alive[(size_t) ch];
+            a.erase (std::remove_if (a.begin(), a.end(), [&] (int index)
+            {
+                auto& voice = voices[(size_t) index];
+                if (! voice.down && ! sustain[(size_t) ch] && ! voice.latched)
+                {
+                    voice.end = time;
+                    return true;
+                }
+                return false;
+            }), a.end());
+        };
+        for (int i = 0; i < sequence.getNumEvents(); ++i)
+        {
+            const auto& m = sequence.getEventPointer (i)->message;
+            const int ch = m.getChannel() - 1;
+            if (ch < 0 || ch >= 16)
+                continue;
+            const auto c = (size_t) ch;
+            const auto time = m.getTimeStamp();
+            if (m.isNoteOn())
+            {
+                keys[c * 128 + (size_t) m.getNoteNumber()] = (int) voices.size();
+                alive[c].push_back ((int) voices.size());
+                voices.push_back ({time, infinity, infinity, i, std::numeric_limits<int>::max(),
+                                   m.getChannel(), m.getNoteNumber(), m.getVelocity(), true, false});
+            }
+            else if (m.isNoteOff())
+            {
+                auto& index = keys[c * 128 + (size_t) m.getNoteNumber()];
+                if (index >= 0)
+                {
+                    auto& voice = voices[(size_t) index];
+                    voice.down = false;
+                    voice.keyEnd = time;
+                    voice.keyEndOrder = i;
+                    index = -1;
+                    close (ch, time);
+                }
+            }
+            else if (m.isController())
+            {
+                const auto cc = m.getControllerNumber();
+                if (cc == 64)
+                {
+                    containsPedals = true;
+                    sustain[c] = m.getControllerValue() >= 64;
+                    pedals[c][0].push_back ({time, m.getControllerValue(), -1});
+                    close (ch, time);
+                }
+                else if (cc == 66)
+                {
+                    containsPedals = true;
+                    const bool on = m.getControllerValue() >= 64;
+                    if (on && ! sostenuto[c])
+                    {
+                        rise[c] = i;
+                        for (auto index : alive[c])
+                            if (voices[(size_t) index].down)
+                                voices[(size_t) index].latched = true;
+                    }
+                    if (! on)
+                        for (auto index : alive[c])
+                            voices[(size_t) index].latched = false;
+                    sostenuto[c] = on;
+                    pedals[c][1].push_back ({time, m.getControllerValue(), rise[c]});
+                    close (ch, time);
+                }
+                else if (cc == 121)
+                {
+                    sustain[c] = sostenuto[c] = false;
+                    pedals[c][0].push_back ({time, 0, -1});
+                    pedals[c][1].push_back ({time, 0, -1});
+                    for (auto index : alive[c])
+                        voices[(size_t) index].latched = false;
+                    close (ch, time);
+                }
+                else if (cc == 120 || cc == 123)
+                {
+                    for (auto index : alive[c])
+                    {
+                        auto& voice = voices[(size_t) index];
+                        voice.down = false;
+                        voice.keyEnd = time;
+                        voice.keyEndOrder = i;
+                        if (cc == 120)
+                            voice.end = time;
+                    }
+                    for (int key = 0; key < 128; ++key)
+                        keys[c * 128 + (size_t) key] = -1;
+                    if (cc == 120)
+                        alive[c].clear();
+                    else
+                        close (ch, time);
+                }
+            }
+        }
+        for (size_t i = 1; i < voices.size(); ++i)
+            jassert (voices[i - 1].start <= voices[i].start);
+        while (leaves < voices.size())
+            leaves *= 2;
+        maxEnds.assign (leaves * 2, -infinity);
+        for (size_t i = 0; i < voices.size(); ++i)
+            maxEnds[leaves + i] = voices[i].end;
+        for (size_t i = leaves; --i > 0;)
+            maxEnds[i] = std::max (maxEnds[i * 2], maxEnds[i * 2 + 1]);
+        reserveMessages = sequence.getNumEvents() + 3 * (int) std::min (voices.size(), size_t (2048)) + 128;
+        controllerReserve = sequence.getNumEvents() + 32;
+    }
+
+    bool hasPedals() const noexcept { return containsPedals; }
+    int getReserveMessages() const noexcept { return reserveMessages; }
+    int getControllerReserve() const noexcept { return controllerReserve; }
+
+    void append (MidiMessageArray& dest, double time, juce::Range<int> channels,
+                 float gain, MPESourceID source) const
+    {
+        std::array<int, 2048> selected;
+        selected.fill (-1);
+        collect (1, 0, leaves, time, selected);
+        for (int channel = channels.getStart(); channel < channels.getEnd(); ++channel)
+        {
+            const auto c = (size_t) (channel - 1);
+            const auto* damper = before (pedals[c][0], time);
+            const auto* latch = before (pedals[c][1], time);
+            const auto latched = [&] (const Voice& v)
+            {
+                return latch && latch->value >= 64 && v.startOrder < latch->riseOrder && v.keyEndOrder > latch->riseOrder;
+            };
+            if (damper)
+                dest.addMidiMessage (juce::MidiMessage::controllerEvent (channel, 64, damper->value), 0.0, source);
+            if (latch && latch->value < 64)
+                dest.addMidiMessage (juce::MidiMessage::controllerEvent (channel, 66, latch->value), 0.0, source);
+            for (bool captured : {true, false})
+            {
+                if (! captured && latch && latch->value >= 64)
+                    dest.addMidiMessage (juce::MidiMessage::controllerEvent (channel, 66, latch->value), 0.0, source);
+                for (int key = 0; key < 128; ++key)
+                    if (const int index = selected[c * 128 + (size_t) key]; index >= 0)
+                    {
+                        const auto& v = voices[(size_t) index];
+                        if (latched (v) != captured)
+                            continue;
+                        auto on = juce::MidiMessage::noteOn (channel, key, (juce::uint8) v.velocity);
+                        on.multiplyVelocity (gain);
+                        dest.addMidiMessage (on, 0.0, source);
+                    }
+            }
+            // Physical releases happen after the pedal's rising edge. The synth
+            // holds the reconstructed voice, while native ActiveNoteList stays accurate.
+            for (int key = 0; key < 128; ++key)
+                if (const int index = selected[c * 128 + (size_t) key]; index >= 0)
+                    if (voices[(size_t) index].keyEnd < time)
+                        dest.addMidiMessage (juce::MidiMessage::noteOff (channel, key), 0.0, source);
+        }
+    }
+
+private:
+    static constexpr double infinity = std::numeric_limits<double>::infinity();
+    struct Voice
+    {
+        double start, keyEnd, end;
+        int startOrder, keyEndOrder, channel, pitch, velocity;
+        bool down, latched;
+    };
+    struct PedalPoint { double time; int value, riseOrder; };
+    std::vector<Voice> voices;
+    std::array<std::array<std::vector<PedalPoint>, 2>, 16> pedals;
+    std::vector<double> maxEnds;
+    size_t leaves = 1;
+    int reserveMessages = 0, controllerReserve = 0;
+    bool containsPedals = false;
+
+    static const PedalPoint* before (const std::vector<PedalPoint>& points, double time) noexcept
+    {
+        const auto it = std::lower_bound (points.begin(), points.end(), time,
+                                         [] (const PedalPoint& p, double t) { return p.time < t; });
+        return it == points.begin() ? nullptr : &*std::prev (it);
+    }
+    void collect (size_t index, size_t first, size_t last, double time, std::array<int, 2048>& selected) const noexcept
+    {
+        if (first >= voices.size() || maxEnds[index] <= time || voices[first].start >= time)
+            return;
+        if (last - first == 1)
+        {
+            const auto& v = voices[first];
+            selected[(size_t) (v.channel - 1) * 128 + (size_t) v.pitch] = (int) first;
+            return;
+        }
+        const auto mid = (first + last) / 2;
+        collect (index * 2, first, mid, time, selected);
+        collect (index * 2 + 1, mid, last, time, selected);
+    }
+};
+
+inline void prepareMidiChaseStorage (MidiMessageArray& storage, int capacity)
+{
+    const auto placeholder = juce::MidiMessage::controllerEvent (1, 64, 0);
+    for (int i = 0; i < capacity; ++i)
+        storage.addMidiMessage (placeholder, 0.0, {});
+    storage.clear();
+}
