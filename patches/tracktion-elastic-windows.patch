+std::unique_ptr<AudioSegmentList> AudioSegmentList::fromPreparedProxy (AudioClipBase& clip, const juce::ValueTree& p)
+{
+    auto list = std::unique_ptr<AudioSegmentList> (new AudioSegmentList (clip));
+    list->crossfadeTime = TimeDuration::fromSeconds (double (p["crossfade_seconds"]));
+    list->segments.ensureStorageAllocated (p.getNumChildren());
+    for (auto n : p)
+    {
+        Segment s;
+        s.start = TimePosition::fromSeconds (double (n["start"]));
+        s.length = TimeDuration::fromSeconds (double (n["length"]));
+        s.startSample = n["start_sample"].toString().getLargeIntValue();
+        s.lengthSample = n["length_sample"].toString().getLargeIntValue();
+        s.stretchRatio = float (n["stretch_ratio"]);
+        s.transpose = float (n["transpose"]);
+        s.fadeIn = bool (n["fade_in"]);
+        s.fadeOut = bool (n["fade_out"]);
+        s.followedBySilence = bool (n["followed_by_silence"]);
+        list->segments.add (s);
+    }
+    return list;
+}
+
 bool AudioSegmentList::operator== (const AudioSegmentList& other) const noexcept
 {
     return crossfadeTime == other.crossfadeTime
