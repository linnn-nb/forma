+    engine.getUIBehaviour().showWarningMessage ("Audio recording failed to write to disk; retained files may be partial");
+    TransportControl::stopAllTransports (engine, false, false);
         engine.getUIBehaviour().showWarningMessage (TRANS("Recording error - disk space is getting dangerously low!"));
     }
 
@@ -2065,6 +2068,9 @@ void WaveInputRecordingThread::run()
 void WaveInputRecordingThread::timerCallback()
 {
     stopTimer();
+    // Surface an actual writer failure before stopping; retained partial media
+    // must never be reported as a successful recording. This runs on the message thread.
+    engine.getUIBehaviour().showWarningMessage ("Audio recording failed to write to disk; retained files may be partial");
     TransportControl::stopAllTransports (engine, false, false);
 }
 
