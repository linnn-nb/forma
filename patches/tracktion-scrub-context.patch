+void TransportControl::prepareAuditionPlayback (TimePosition startTime, std::function<void (EditPlaybackContext&)> configure)
+{
+    TRACKTION_ASSERT_MESSAGE_THREAD
+    if (! edit.shouldPlay() || edit.isRendering())
+        return;
+
+    if (playbackContext == nullptr)
+    {
+        playbackContext = std::make_unique<EditPlaybackContext> (*this, false);
+        transportState->playbackContextAllocation = transportState->playbackContextAllocation + 1;
+    }
+
+    configure (*playbackContext);
+    playbackContext->createPlayAudioNodes (startTime);
+}
